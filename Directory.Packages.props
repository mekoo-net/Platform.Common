<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Service Discovery (Consul)">
    <PackageVersion Include="Consul" Version="1.8.0" />
    <!--
      Platform.Common.Discovery 不带 ASP.NET Core 框架引用，这三个抽象得按包引。版本跟本文件其余 Microsoft.Extensions.*
      对齐，别往高钉：开启传递性中央钉版的仓若把它们钉得更低，会报 NU1109（Platform、Demux 钉的 Logging.Abstractions 就是 10.0.14）。
    -->
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup Label="Messaging (MassTransit v8, Apache-2.0)">
    <!-- 与 Meeko.Platform 根 Directory.Packages.props 保持同版本，避免同一输出目录里出现两个 MassTransit。 -->
    <PackageVersion Include="MassTransit.RabbitMQ" Version="8.5.10" />
  </ItemGroup>

  <ItemGroup Label="MagicOnion (RPC)">
    <PackageVersion Include="MagicOnion.Client" Version="7.11.0" />
    <PackageVersion Include="Grpc.Net.Client" Version="2.85.0" />
  </ItemGroup>

  <ItemGroup Label="PostgreSQL">
    <!--
      只用 NpgsqlConnectionStringBuilder 做连接串组装/转义，不引 EF provider。
      版本不能低于 10.0.3：各产品仓的 Npgsql.EntityFrameworkCore.PostgreSQL 10.0.2
      依赖 Npgsql (>= 10.0.3)，钉低了会在开启传递性中央钉版的仓（如 Tavern）触发 NU1109 降级错误。
    -->
    <PackageVersion Include="Npgsql" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup Label="Cache (Redis + FusionCache)">
    <PackageVersion Include="StackExchange.Redis" Version="2.13.17" />
    <PackageVersion Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.14" />
    <PackageVersion Include="ZiggyCreatures.FusionCache" Version="2.6.0" />
    <PackageVersion Include="ZiggyCreatures.FusionCache.Serialization.SystemTextJson" Version="2.6.0" />
    <PackageVersion Include="ZiggyCreatures.FusionCache.Backplane.StackExchangeRedis" Version="2.6.0" />
  </ItemGroup>

  <ItemGroup Label="Serilog">
    <PackageVersion Include="Serilog" Version="4.3.1" />
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.OpenTelemetry" Version="4.2.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
  </ItemGroup>

  <ItemGroup Label="OpenTelemetry">
    <PackageVersion Include="OpenTelemetry" Version="1.15.3" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.15.3" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.15.3" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.15.2" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.15.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.15.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.GrpcNetClient" Version="1.15.1-beta.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.EntityFrameworkCore" Version="1.15.1-beta.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.StackExchangeRedis" Version="1.15.1-beta.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Hangfire" Version="1.15.1-beta.1" />
  </ItemGroup>

  <ItemGroup Label="Misc">
    <PackageVersion Include="MessagePack" Version="3.1.12" />
    <PackageVersion Include="NetEscapades.Configuration.Yaml" Version="3.1.0" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.14" />
  </ItemGroup>
</Project>
