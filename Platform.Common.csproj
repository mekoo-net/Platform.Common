<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImportDirectoryBuildProps>false</ImportDirectoryBuildProps>
    <ImportDirectoryBuildTargets>false</ImportDirectoryBuildTargets>
  </PropertyGroup>

  <PropertyGroup>
    <RootNamespace>Platform.Common</RootNamespace>
    <Description>Platform shared infrastructure (no business code, no contracts). Layout: Core/ (Results, Web, Correlation, Paging), Infrastructure/ (Caching, Discovery, Hosting, Observability, HealthChecks). The Consul registration base lives in Platform.Common.Discovery/.</Description>
    <IsPackable>false</IsPackable>
    <!-- 子目录是另一个项目，默认通配会把它的源文件和 obj/ 也编进来。 -->
    <DefaultItemExcludes>$(DefaultItemExcludes);Platform.Common.Discovery/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Meeko.Keystone.Tests" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="Platform.Common.Discovery/Platform.Common.Discovery.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.OpenTelemetry" />
    <PackageReference Include="Serilog.Sinks.Console" />

    <PackageReference Include="OpenTelemetry" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
    <PackageReference Include="OpenTelemetry.Instrumentation.GrpcNetClient" />
    <PackageReference Include="OpenTelemetry.Instrumentation.EntityFrameworkCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.StackExchangeRedis" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Hangfire" />

    <PackageReference Include="MagicOnion.Client" />

    <PackageReference Include="MassTransit.RabbitMQ" />

    <PackageReference Include="MessagePack" />

    <PackageReference Include="Npgsql" />

    <PackageReference Include="StackExchange.Redis" />
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" />
    <PackageReference Include="ZiggyCreatures.FusionCache" />
    <PackageReference Include="ZiggyCreatures.FusionCache.Serialization.SystemTextJson" />
    <PackageReference Include="ZiggyCreatures.FusionCache.Backplane.StackExchangeRedis" />

    <PackageReference Include="NetEscapades.Configuration.Yaml" />
    <PackageReference Include="VaultSharp" />

    <PackageReference Include="Consul" />
    <PackageReference Include="Grpc.Net.Client" />
  </ItemGroup>

</Project>
